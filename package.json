{
  "name": "lot-map",
  "version": "0.1.0",
  "description": "A live work map beside the chat for OpenCode Desktop: what the session is doing, station by station. A port of alexeyw/lot-map.",
  "license": "MIT",
  "author": "Narxib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Narxib/lot-map.git"
  },
  "homepage": "https://github.com/Narxib/lot-map#readme",
  "bugs": {
    "url": "https://github.com/Narxib/lot-map/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "work-map",
    "visualization",
    "desktop"
  ],
  "type": "module",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "release": "npm run typecheck && npm run build && npm publish"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
